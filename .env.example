# Single-provider mode
NEXTORCA_BASE_URL=  # Optional override; OpenAI-compatible defaults to localhost, native APIs use vendor endpoints
NEXTORCA_MODEL=your-local-model
NEXTORCA_API_KEY=

# Optional hybrid local/cloud mode
NEXTORCA_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
NEXTORCA_LOCAL_MODEL=your-local-model
NEXTORCA_LOCAL_API_KEY=
NEXTORCA_CLOUD_BASE_URL=https://openrouter.ai/api/v1
NEXTORCA_CLOUD_MODEL=your-provider/cloud-model
NEXTORCA_CLOUD_API_KEY=
NEXTORCA_ROUTE_MODE=auto
NEXTORCA_PRIVACY_MODE=balanced

# Native provider credentials
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NEXTORCA_CLAUDE_COMMAND=claude
NEXTORCA_CODEX_COMMAND=codex
